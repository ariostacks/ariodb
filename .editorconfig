root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{sh,md,yml,yaml,json,toml,ts,tsx,js,css,html}]
indent_size = 2

[*.md]
# Trailing spaces can be a line break in Markdown.
trim_trailing_whitespace = false

[Makefile]
indent_style = tab

[dashboard/dist/**]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
indent_style = unset
indent_size = unset
